{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jeem",
  "version": "0.5.0",
  "identifier": "com.jeem.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNEEyNTk0NTYyOURENzkKUldSNTNTbFdsQ1ZLNHMySVlMYjdjZWZuRWRSaExnSmxhaitDbFJYQ3pxbnRCUHZQRTBvTjlmNEkK",
      "endpoints": ["https://github.com/Surse231/jeem-releases/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
